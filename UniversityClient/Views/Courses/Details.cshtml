@model UniversityClient.Models.CourseItem
@{
    ViewData["Title"] = "Детали курса";
    var version = ViewBag.Version as string ?? "v1";
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="container py-4">
    <a asp-action="Index" asp-route-version="@version" class="btn btn-secondary mb-3">&larr; Назад к списку</a>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">
            <h4>Ошибка</h4>
            <p class="mb-0">@ViewBag.Error</p>
        </div>
    }
    else if (Model != null)
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">@Model.Name (Версия @version)</h3>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">ID курса</dt>
                    <dd class="col-sm-9">@Model.Id</dd>

                    <dt class="col-sm-3">Описание</dt>
                    <dd class="col-sm-9">@Model.Description</dd>

                    <dt class="col-sm-3">Количество кредитов</dt>
                    <dd class="col-sm-9">@Model.Credits</dd>

                    <dt class="col-sm-3">Преподаватель</dt>
                    <dd class="col-sm-9">@Model.TeacherName (ID: @Model.TeacherId)</dd>

                    @if (version == "v2")
                    {
                        <dt class="col-sm-3">Уровень сложности</dt>
                        <dd class="col-sm-9"><span class="badge bg-info text-dark">@(Model.DifficultyLevel ?? "Не указан")</span></dd>

                        <dt class="col-sm-3">Пререквизиты</dt>
                        <dd class="col-sm-9">@(Model.Prerequisites ?? "Отсутствуют")</dd>
                    }
                </dl>
            </div>
        </div>
    }
</body>
</html>