@model List<UniversityClient.Models.CourseItem>
@{
    ViewData["Title"] = "Список курсов";
    var version = (ViewData["Version"] as string ?? "v1").ToLower();
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Управление курсами (MVC Client)</h2>
        <div>
            <a href="/Courses/Index?version=v1" class="btn @(version == "v1" ? "btn-primary" : "btn-outline-primary")">API v1</a>
            <a href="/Courses/Index?version=v2" class="btn @(version == "v2" ? "btn-primary" : "btn-outline-primary")">API v2 (Extended)</a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger shadow-sm">
            <h4>Ошибка получения данных</h4>
            <p class="mb-0">@ViewBag.Error</p>
        </div>
    }
    else if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped align-middle">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Название</th>
                    <th>Кредиты</th>
                    <th>Преподаватель</th>
                    @if (version == "v2")
                    {
                        <th>Сложность</th>
                        <th>Пререквизиты</th>
                    }
                    <th>Действия</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Model)
                {
                    <tr>
                        <td>@course.Id</td>
                        <td><strong>@course.Name</strong></td>
                        <td>@course.Credits</td>
                        <td>@course.TeacherName</td>
                        @if (version == "v2")
                        {
                            <td><span class="badge bg-info text-dark">@(string.IsNullOrEmpty(course.DifficultyLevel) ? "Базовый" : course.DifficultyLevel)</span></td>
                            <td>@(string.IsNullOrEmpty(course.Prerequisites) ? "Нет" : course.Prerequisites)</td>
                        }
                        <td>
                            <a href="/Courses/Details/@course.Id?version=@version" class="btn btn-sm btn-info text-white">Подробнее</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="alert alert-info">Курсы не найдены.</div>
    }
</body>
</html>